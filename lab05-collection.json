    {
      "name": "01 Happy path - active student with prerequisites",
      "item": [
        {
          "name": "Setup student S01",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}"
            },
            "url": "{{baseUrl}}/students/S01"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('setup student is OK', () => pm.expect(pm.response.code).to.eql(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup course C01",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}"
            },
            "url": "{{baseUrl}}/courses/C01"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('setup course is OK', () => pm.expect(pm.response.code).to.eql(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register successfully",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"S01\",\"courseID\":\"C01\"}"
            },
            "url": "{{baseUrl}}/registrations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json();",
                  "pm.test('status is 201',()=>pm.expect(pm.response.code).to.eql(201));",
                  "pm.test('result is OK',()=>pm.expect(j.result).to.eql('OK'));",
                  "pm.test('registrationID is numeric',()=>pm.expect(j.registrationID).to.be.a('number')); "
                ]
              }
            }
          ]
        }
      ]
